{
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "module": "es2015",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "target": "es5",
    "jsx": "react",
    "strictNullChecks": true,
    "importHelpers": true,
    "rootDirs": ["./"],
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["node_modules", "dist"]
}
